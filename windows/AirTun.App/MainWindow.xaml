<Window
    x:Class="AirTun.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{StaticResource WindowSolidBrush}">
        <!-- Main area: rows for titlebar + content. The nav rail overlays as a sibling below. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Seamless Dark TitleBar -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" Padding="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="Assets/TitleBarLogo.png" Height="20" VerticalAlignment="Center" Stretch="Uniform" />
                <Border Background="{StaticResource FillTertiary}" CornerRadius="6" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                    <TextBlock Text="v1.1" FontSize="11" Foreground="{StaticResource LabelSecondary}" />
                </Border>
            </StackPanel>

            <!-- Controls: Language Toggle + Beautiful System Buttons (Min, Close) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BtnLangToggle" Content="FA" Padding="10,3" Height="30" MinHeight="30" FontSize="12" Style="{StaticResource SecondaryButton}" Click="BtnLangToggle_Click" ToolTipService.ToolTip="Toggle Language (FA / EN)" />

                <!-- System Window Buttons (No Maximize) -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0,0,0">
                    <!-- Minimize button (Amber / Yellow) -->
                    <Button x:Name="BtnWinMin" Width="26" Height="26" Padding="0" MinWidth="26" MinHeight="26" Background="Transparent" BorderThickness="0" Style="{StaticResource QuietButton}" Click="BtnWinMin_Click" ToolTipService.ToolTip="Minimize">
                        <Border Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" BorderBrush="#33000000" BorderThickness="1" />
                    </Button>
                    <!-- Close button (Red) -->
                    <Button x:Name="BtnWinClose" Width="26" Height="26" Padding="0" MinWidth="26" MinHeight="26" Background="Transparent" BorderThickness="0" Style="{StaticResource QuietButton}" Click="BtnWinClose_Click" ToolTipService.ToolTip="Close">
                        <Border Width="12" Height="12" CornerRadius="6" Background="#FF5F56" BorderBrush="#33000000" BorderThickness="1" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- TAB CONTENT CONTAINER -->
        <Grid Grid.Row="1" Padding="18,10,76,10">

            <!-- TAB 1: CONNECT -->
            <ScrollViewer x:Name="ViewTabConnect" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                <StackPanel Spacing="12">

                    <!-- Status Hero Banner -->
                    <Border Background="{StaticResource NmCardBrush}" CornerRadius="16" Padding="16,12" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="TextStatus" Text="Ready to Connect" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" x:Name="PillStatusMode" Background="{StaticResource FillSunken}" CornerRadius="8" Padding="9,3" VerticalAlignment="Center" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="TextStatusMode" Text="⚡ TUN" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource LabelSecondary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- IDLE & DISCOVERY STATE -->
                    <StackPanel x:Name="PanelIdle" Spacing="12">

                        <!-- Mode Selector Segmented Cards -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- TUN Mode Card -->
                            <Border Grid.Column="0" x:Name="CardModeTun" CornerRadius="16" Padding="12,14" Background="{StaticResource NmCardSelectedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" PointerPressed="CardModeTun_PointerPressed" ToolTipService.ToolTip="Routes 100% of Windows traffic through virtual network adapter (Gaming, Telegram, Git, Docker, Browsers)">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡ TUN Mode" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TextTunSub" Text="System-wide, games &amp; apps" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Proxy Mode Card -->
                            <Border Grid.Column="1" x:Name="CardModeProxy" CornerRadius="16" Padding="12,14" Background="{StaticResource NmCardBrush}" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1" PointerPressed="CardModeProxy_PointerPressed" ToolTipService.ToolTip="Configures Windows system proxy for browsers and standard HTTP/HTTPS web apps">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="🌐 Web Proxy" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TextProxySub" Text="Browsers &amp; web only" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Auto-Discovered Phone Card - Premium Style -->
                        <Border Background="{StaticResource NmCardBrush}" CornerRadius="20" Padding="0" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Subtle top accent line -->
                                <Border Height="2" VerticalAlignment="Top" Background="{StaticResource AccentBrush}" />
                                <StackPanel Spacing="0" Margin="0,2,0,0">
                                    <!-- Header row -->
                                    <Grid Padding="18,14,18,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Phone icon circle -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{StaticResource FillSunken}" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                            <TextBlock Text="📱" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="TextDetectedPhoneName" Text="Searching for Phone..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="TextDetectedPhoneIp" Text="Turn on Hotspot and tap START in mobile app" FontSize="12" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="BadgeSignal" Background="{StaticResource FillSunken}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                            <TextBlock x:Name="TextSignalStatus" Text="📡 Scanning" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="18,0" />

                                    <!-- PIN section -->
                                    <StackPanel Padding="18,14,18,18" Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TextPinHint" Grid.Column="0" Text="4-digit Security PIN" FontSize="13" Foreground="{StaticResource LabelSecondary}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TextAutoDetected" Grid.Column="1" Text="Auto-detected ✓" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBox x:Name="InputPin" PlaceholderText="· · · ·" MaxLength="4" FontSize="28" FontWeight="Bold" TextAlignment="Center" Height="56" FontFamily="{StaticResource FontMono}" CornerRadius="12" BorderThickness="1" Foreground="{StaticResource AccentBrush}">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlBackground" Color="#090C12"/>
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0C101A"/>
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#090C12"/>
                                                <SolidColorBrush x:Key="TextControlForeground" Color="#00E5FF"/>
                                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#00E5FF"/>
                                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#00E5FF"/>
                                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#2D3F55"/>
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#2D3F55"/>
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#2D3F55"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1A2230"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#262F3F"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#00E5FF"/>
                                                <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#3300E5FF"/>
                                            </TextBox.Resources>
                                        </TextBox>
                                        
                                        <!-- Connect to Phone Button with Ambient Cyan Glow -->
                                        <Grid Margin="0,4,0,0">
                                            <Border Height="48" CornerRadius="14" Background="{StaticResource AccentBrush}" Opacity="0.35" Margin="2,4,2,-4" />
                                            <Button x:Name="BtnConnect" Content="Connect to Phone" FontSize="16" FontWeight="ExtraBold" Height="48" Style="{StaticResource PrimaryButton}" Click="BtnConnect_Click" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quick Tips Card -->
                        <Border Background="{StaticResource NmCardBrush}" CornerRadius="16" Padding="16,14" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="TextQuickTipsLabel" Text="QUICK TIPS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LabelSecondary}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚡" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" x:Name="TextTip1" FontSize="12" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" LineHeight="18">
                                        Use <Run FontWeight="Bold" Foreground="{StaticResource LabelPrimary}">TUN Mode</Run> for games and all-system routing.
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🌐" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" x:Name="TextTip2" FontSize="12" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" LineHeight="18">
                                        Use <Run FontWeight="Bold" Foreground="{StaticResource LabelPrimary}">Web Proxy</Run> for browser-only traffic.
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📡" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" x:Name="TextTip3" FontSize="12" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" LineHeight="18">
                                        Make sure <Run FontWeight="Bold" Foreground="{StaticResource LabelPrimary}">Hotspot</Run> is active on your phone.
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- CONNECTED ACTIVE STATE -->
                    <StackPanel x:Name="PanelConnected" Spacing="10" Visibility="Collapsed">
                        <Border Background="{StaticResource NmCardBrush}" CornerRadius="18" Padding="16,13" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                            <StackPanel Spacing="9">
                                <!-- Endpoint & Badge -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Name="TextConnectedDevice" Text="Connected to Phone" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock x:Name="TextConnectedEndpoint" Text="192.168.43.1:10808 (TUN Mode)" FontSize="12.5" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource LabelSecondary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource FillSunken}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="● ACTIVE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Outbound IP & Location -->
                                <Border Background="{StaticResource FillSunken}" CornerRadius="12" Padding="12,7" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="TextGeoLocation" Text="🌐 Resolving location..." FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                            <TextBlock x:Name="TextGeoIsp" Text="Detecting public IP &amp; ISP..." FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnRefreshGeo" Content="🔄" Padding="8,3" Height="30" MinHeight="30" FontSize="13.5" Style="{StaticResource QuietButton}" Click="BtnRefreshGeo_Click" ToolTipService.ToolTip="Refresh Location &amp; IP" />
                                    </Grid>
                                </Border>

                                <!-- LIVE TRAFFIC WAVEFORM / GRAPH -->
                                <Border Background="{StaticResource FillSunken}" CornerRadius="12" Padding="12,7" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock x:Name="TextLiveTrafficHeader" Text="Live Network Waveform" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center" />
                                                <Border Background="{StaticResource FillTertiary}" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TextPeakSpeed" Text="Peak: 0 KB/s" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Down" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <Ellipse Width="7" Height="7" Fill="#FF38BDF8" VerticalAlignment="Center" />
                                                    <TextBlock Text="Up" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Canvas Graph Container -->
                                        <Border Height="56" Background="{StaticResource FillSunken}" CornerRadius="8" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                            <Canvas x:Name="CanvasTrafficGraph" Height="56" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Live Speed Gauges -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource FillSunken}" CornerRadius="12" Padding="10,7" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                                            <TextBlock Text="↓ Download Rate" FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                                            <TextBlock x:Name="TextDownSpeed" Text="0 KB/s" FontSize="21" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="TextDownTotal" Text="Total: 0 MB" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource FillSunken}" CornerRadius="12" Padding="10,7" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                                            <TextBlock Text="↑ Upload Rate" FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                                            <TextBlock x:Name="TextUpSpeed" Text="0 KB/s" FontSize="21" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="TextUpTotal" Text="Total: 0 MB" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Latency & Duration -->
                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TextLatency" Text="Latency: 18 ms" FontSize="12.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" x:Name="TextDuration" Text="Duration: 00:02:14" FontSize="12.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnDisconnect" Content="Disconnect" FontSize="15.5" FontWeight="Bold" Height="44" Style="{StaticResource DangerButton}" Click="BtnDisconnect_Click" />
                    </StackPanel>

                    <!-- ERROR PANEL -->
                    <StackPanel x:Name="PanelError" Spacing="16" Visibility="Collapsed">
                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="18" Padding="20" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TextErrorTitle" Text="Connection Error" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock x:Name="TextErrorBody" Text="Cannot reach the Android device." FontSize="15.5" Foreground="{StaticResource LabelPrimary}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnErrorDismiss" Content="Dismiss" FontSize="16" Height="48" Style="{StaticResource SecondaryButton}" Click="BtnErrorDismiss_Click" />
                            <Button Grid.Column="1" x:Name="BtnErrorRetry" Content="Retry" FontSize="16" Height="48" Style="{StaticResource PrimaryButton}" Click="BtnErrorRetry_Click" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: DNS -->
            <ScrollViewer x:Name="ViewTabDns" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="DNS Servers" FontSize="20" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                        <TextBlock Text="Choose which resolver the tunnel and Windows use" FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                    </StackPanel>
                    <StackPanel x:Name="DnsListPanel" Spacing="8" />
                    <Button x:Name="BtnAddDns" Content="+ Add custom DNS" HorizontalAlignment="Stretch" Padding="0,10"
                            Style="{StaticResource SecondaryButton}" Click="BtnAddDns_Click" />
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: AI ACCESS -->
            <ScrollViewer x:Name="ViewTabAiAccess" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="AI Access" FontSize="20" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                        <TextBlock Text="Diagnose and fix 403 blocks on Gemini / ChatGPT / Claude" FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                    </StackPanel>

                    <!-- IPv6 Leak Test -->
                    <Border CornerRadius="14" Padding="16,12" Background="{StaticResource NmCardBrush}" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="IPv6 Leak Test" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                <Button x:Name="BtnIpv6Test" Content="Run test" HorizontalAlignment="Right" Padding="12,5"
                                        Style="{StaticResource SecondaryButton}" Click="BtnIpv6Test_Click" />
                            </Grid>
                            <TextBlock x:Name="TextIpv6Result" Text="Checks whether AAAA (IPv6) traffic escapes the tunnel — the #1 hidden cause of Google 403s." FontSize="11.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Exit IP Reputation -->
                    <Border CornerRadius="14" Padding="16,12" Background="{StaticResource NmCardBrush}" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Exit IP Check" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                <Button x:Name="BtnIpRep" Content="Check IP" HorizontalAlignment="Right" Padding="12,5"
                                        Style="{StaticResource SecondaryButton}" Click="BtnIpRep_Click" />
                            </Grid>
                            <TextBlock x:Name="TextIpRep" Text="Verifies your exit country is Gemini-supported and flags datacenter IPs that Google distrusts." FontSize="11.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- WARP guidance -->
                    <Border CornerRadius="14" Padding="16,12" Background="{StaticResource NmCardBrush}" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Still blocked? Chain WARP" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                            <TextBlock Text="Route Google/AI domains through Cloudflare WARP after the tunnel — WARP exit IPs have a clean reputation with Google. Configure a wireguard-outbound to WARP in your proxy app, or use a WARP-over-proxy subscription." FontSize="11.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 4: ROUTING -->
            <ScrollViewer x:Name="ViewTabRouting" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="TextRoutingTitle" Text="Smart Routing Rules" FontSize="18" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                        <TextBlock x:Name="TextRoutingSubtitle" Text="Direct connection without routing through proxy" FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                    </StackPanel>

                    <!-- Iran Bypass Card -->
                    <Border Background="{StaticResource NmCardBrush}" CornerRadius="16" Padding="16,12" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock x:Name="TextBypassTitle" Text="Bypass Domestic Sites (.ir)" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                <TextBlock x:Name="TextBypassDesc" Text="Iranian banking &amp; national websites" FontSize="12" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwitchBypassDomestic" IsOn="True" Toggled="SwitchBypassDomestic_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" />
                        </Grid>
                    </Border>

                    <!-- LAN Bypass Card -->
                    <Border Background="{StaticResource NmCardBrush}" CornerRadius="16" Padding="16,12" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock x:Name="TextBypassLanTitle" Text="Bypass Local Network (LAN)" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                <TextBlock x:Name="TextBypassLanDesc" Text="192.168.x, 10.x, 127.0.0.1" FontSize="12" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwitchBypassLan" IsOn="True" Toggled="SwitchBypassLan_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" />
                        </Grid>
                    </Border>

                    <!-- Custom Rules Section -->
                    <Border Background="{StaticResource NmCardBrush}" CornerRadius="16" Padding="16" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TextCustomRulesHeader" Text="Custom Bypass Rules" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                <TextBlock x:Name="TextCustomRulesDesc" Text="Add domains/IPs to bypass the tunnel:" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" />
                            </StackPanel>

                            <!-- Add Rule Form -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="InputNewRulePattern" FontSize="13.5" PlaceholderText="e.g. *.digikala.com or 1.1.1.1" Height="40" CornerRadius="10" Background="{StaticResource FillSunken}" BorderBrush="{StaticResource NmSunkenBorderBrush}" />
                                <Button Grid.Column="1" x:Name="BtnAddRule" Content="+ Add" Padding="14,4" FontSize="13.5" FontWeight="Bold" Style="{StaticResource PrimaryButton}" Height="40" Click="BtnAddRule_Click" />
                            </Grid>

                            <!-- System *.ir Chip -->
                            <Border Background="#1A332400" BorderBrush="#55FFB900" BorderThickness="1" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="*.ir" FontSize="12" FontWeight="Bold" Foreground="#FFFFB900" VerticalAlignment="Center" />
                                    <Border Background="#33FFB900" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                        <TextBlock Text="🔒 SYS" FontSize="9" FontWeight="Bold" Foreground="#FFFFB900" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Rules List -->
                            <ListView x:Name="ListCustomRules" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource FillSunken}" CornerRadius="10" Padding="10,6" Margin="0,3" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Pattern}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="✕" Padding="8,2" Height="28" MinHeight="28" FontSize="12" Style="{StaticResource QuietButton}" Click="BtnDeleteRule_Click" Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 5: LOGS -->
            <Grid x:Name="ViewTabLogs" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="TextLogsHeader" Text="System Logs" FontSize="17" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource FillTertiary}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TextLogCount" Text="0 entries" FontSize="11" Foreground="{StaticResource LabelSecondary}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="BtnAutoScrollToggle" Content="⇣ Auto" Padding="10,3" Height="32" MinHeight="32" FontSize="12" Style="{StaticResource SecondaryButton}" Click="BtnAutoScrollToggle_Click" ToolTipService.ToolTip="Auto-scroll to latest log" />
                        <Button x:Name="BtnCopyLogs" Content="Copy" Padding="10,3" Height="32" MinHeight="32" FontSize="12.5" Style="{StaticResource SecondaryButton}" Click="BtnCopyLogs_Click" />
                        <Button x:Name="BtnClearLogs" Content="Clear" Padding="10,3" Height="32" MinHeight="32" FontSize="12.5" Style="{StaticResource DangerButton}" Click="BtnClearLogs_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource FillSunken}" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1" CornerRadius="14" Margin="0,0,0,4">
                    <ScrollViewer x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12,14,24" ViewChanged="ScrollLogs_ViewChanged">
                        <TextBlock x:Name="TextLogsViewer" TextWrapping="Wrap" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource LabelPrimary}" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- TAB 6: SETTINGS & ABOUT -->
            <ScrollViewer x:Name="ViewTabAbout" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="14">

                    <!-- App & Tray Settings Card -->
                    <Border Background="{StaticResource NmCardBrush}" CornerRadius="16" Padding="18" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="TextSettingsHeader" Text="System &amp; Tray Settings" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />

                            <!-- Start with Windows Switch -->
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock x:Name="TextStartWithWindowsTitle" Text="Start with Windows" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" />
                                    <TextBlock x:Name="TextStartWithWindowsDesc" Text="Launch automatically on system boot" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SwitchStartWithWindows" IsOn="False" Toggled="SwitchStartWithWindows_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" />
                            </Grid>

                            <!-- Close to Tray Switch -->
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock x:Name="TextCloseToTrayTitle" Text="Close to Tray (X button)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" />
                                    <TextBlock x:Name="TextCloseToTrayDesc" Text="Keep running in background when closed" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SwitchCloseToTray" IsOn="False" Toggled="SwitchCloseToTray_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" />
                            </Grid>

                            <!-- Minimize to Tray Switch -->
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock x:Name="TextMinimizeToTrayTitle" Text="Minimize to Tray (_ button)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" />
                                    <TextBlock x:Name="TextMinimizeToTrayDesc" Text="Send to taskbar tray instead of minimizing" FontSize="11.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SwitchMinimizeToTray" IsOn="False" Toggled="SwitchMinimizeToTray_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" />
                            </Grid>

                            <!-- GitHub Repository Neumorphic Card -->
                            <Border Background="{StaticResource FillSunken}" CornerRadius="12" Padding="12,10" Margin="0,6,0,0" BorderBrush="{StaticResource NmSunkenBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource FillTertiary}" VerticalAlignment="Center">
                                            <TextBlock Text="🐙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:Name="TextGithubLabel" Text="GitHub Repository" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                            <TextBlock Text="omid-io / AirTun" FontSize="10.5" Foreground="{StaticResource LabelSecondary}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnOpenGithub" Content="Open ↗" Padding="10,4" Height="30" MinHeight="30" FontSize="11.5" FontWeight="Bold" Style="{StaticResource SecondaryButton}" Click="BtnOpenGithub_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- RIGHT RAIL NAVIGATION (overlays row 1, right-aligned; content area has right padding) -->
        <Border Grid.Row="1" HorizontalAlignment="Right" Width="58" Background="{StaticResource NmCardBrush}" BorderBrush="{StaticResource NmBorderBrush}" BorderThickness="1,0,0,0">
            <StackPanel VerticalAlignment="Top" Spacing="4" Padding="6,12,6,8">
                <!-- Connect -->
                <Button x:Name="NavBtnConnect" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0,6" Click="NavBtnConnect_Click">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Path x:Name="NavIconConnect"
                              Data="M13 2L3 14 12 14 11 22 21 10 12 10 13 2Z"
                              Width="19" Height="19" Stretch="Uniform"
                              Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NavTextConnect" Text="Connect" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- DNS -->
                <Button x:Name="NavBtnDns" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0,6" Click="NavBtnDns_Click">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Path x:Name="NavIconDns"
                              Data="M12 2A10 10 0 1 0 22 12 M2 12h20 M12 2a15.3 15.3 0 0 1 0 20 M12 2a15.3 15.3 0 0 0 0 20"
                              Width="18" Height="18" Stretch="Uniform"
                              Fill="Transparent" Stroke="{StaticResource LabelSecondary}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NavTextDns" Text="DNS" FontSize="10" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- AI Access -->
                <Button x:Name="NavBtnAi" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0,6" Click="NavBtnAi_Click">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Path x:Name="NavIconAi"
                              Data="M12 2a7 7 0 0 1 7 7c0 2.4-1.2 4.5-3 5.7V17h-8v-2.3C6.2 13.5 5 11.4 5 9a7 7 0 0 1 7-7z M9 21h6"
                              Width="18" Height="18" Stretch="Uniform"
                              Fill="Transparent" Stroke="{StaticResource LabelSecondary}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NavTextAi" Text="AI" FontSize="10" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Routing -->
                <Button x:Name="NavBtnRouting" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0,6" Click="NavBtnRouting_Click">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Path x:Name="NavIconRouting"
                              Data="M6 3L6 15 M21 6A3 3 0 1 0 15 6A3 3 0 1 0 21 6 M9 18A3 3 0 1 0 3 18A3 3 0 1 0 9 18 M18 9a9 9 0 0 1-9 9"
                              Width="18" Height="18" Stretch="Uniform"
                              Fill="Transparent" Stroke="{StaticResource LabelSecondary}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NavTextRouting" Text="Routing" FontSize="10" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Logs -->
                <Button x:Name="NavBtnLogs" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0,6" Click="NavBtnLogs_Click">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Path x:Name="NavIconLogs"
                              Data="M4 17L10 11L4 5 M12 19L20 19"
                              Width="18" Height="18" Stretch="Uniform"
                              Fill="Transparent" Stroke="{StaticResource LabelSecondary}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NavTextLogs" Text="Logs" FontSize="10" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Settings (pushed to bottom via spacer) -->
                <StackPanel VerticalAlignment="Bottom" Spacing="4">
                    <Button x:Name="NavBtnAbout" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0,6" Click="NavBtnAbout_Click">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <Path x:Name="NavIconAbout"
                                  Data="M15 12A3 3 0 1 0 9 12A3 3 0 1 0 15 12Z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{StaticResource LabelSecondary}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NavTextAbout" Text="Settings" FontSize="10" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
